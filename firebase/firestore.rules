rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function orgMatch(oid) {
      return isAuthed() && request.auth.token.org_id == oid;
    }

    function activeClinic(oid, cid) {
      return orgMatch(oid) && request.auth.token.active_clinic_id == cid;
    }

    function isOrgOwner() {
      return isAuthed() && request.auth.token.role == 'owner';
    }

    // Staff ("viewer") accounts read + print only; clinical writes need a
    // clinician role. Mirrors the backend's require_clinician dependency.
    function isClinician() {
      return isAuthed() && request.auth.token.role in ['owner', 'admin', 'doctor'];
    }

    // ─── Backend runtime config (payment keys etc.) ────────────────
    // Read/written ONLY by the backend via Admin SDK. Never client-readable.
    match /app_config/{doc} {
      allow read, write: if false;
    }

    // ─── Global user profiles ──────────────────────────────────────
    // One doc per Firebase user at users/{uid} with their memberships.
    // Writes happen through the backend (Admin SDK); clients read their own.
    match /users/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── Organizations ─────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if orgMatch(orgId);
      allow write: if false; // backend-only via Admin SDK

      match /clinics/{clinicId} {
        // Any org member can read clinics in their org (clinic switcher).
        allow read: if orgMatch(orgId);
        allow write: if false;

        match /doctors/{doctorUid} {
          allow read: if orgMatch(orgId);
          // A doctor can update their own clinic-specific profile.
          allow write: if activeClinic(orgId, clinicId)
                      && request.auth.uid == doctorUid;
        }

        match /patients/{patientId} {
          allow read: if activeClinic(orgId, clinicId);
          allow write: if activeClinic(orgId, clinicId) && isClinician();

          match /recordings/{recordingId} {
            allow read: if activeClinic(orgId, clinicId);
            allow write: if activeClinic(orgId, clinicId) && isClinician();
          }
        }

        // Clinic-level audit: org owner only; writes via backend.
        match /audit/{eventId} {
          allow read:  if orgMatch(orgId) && isOrgOwner();
          allow write: if false;
        }
      }

      // Org-level audit (billing, admin actions)
      match /audit/{eventId} {
        allow read:  if orgMatch(orgId) && isOrgOwner();
        allow write: if false;
      }

      // AI usage + cost accounting — backend-only. Cost data must NEVER be
      // readable by clients.
      match /usage/{recordingId} {
        allow read, write: if false;
      }

      // Wallet balance + subscription state: org owner can read; all writes
      // go through the backend (Razorpay verification).
      match /billing/{docId} {
        allow read:  if orgMatch(orgId) && isOrgOwner();
        allow write: if false;

        match /transactions/{txId} {
          allow read:  if orgMatch(orgId) && isOrgOwner();
          allow write: if false;
        }
      }

      // Razorpay payment orders — backend-only (contain gateway internals).
      match /payments/{orderId} {
        allow read, write: if false;
      }

      // Invite codes for joining the org
      match /invites/{code} {
        allow read, write: if orgMatch(orgId) && isOrgOwner();
      }
    }
  }
}
