rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All clinical artifacts live under organizations/{orgId}/clinics/{clinicId}/...
    // Access requires an ID token whose claims match both the org and the
    // currently-active clinic. Backend writes (Admin SDK) bypass these rules.
    match /organizations/{orgId}/clinics/{clinicId}/{allPaths=**} {
      allow read, write: if request.auth != null
                        && request.auth.token.org_id == orgId
                        && request.auth.token.active_clinic_id == clinicId;
    }

    // Everything else: deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
