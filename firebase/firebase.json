{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "soapnotesai",
    "public": "hosting-dist",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "_comment_storage": "Cloud Storage section intentionally omitted — local-files-only v1. storage.rules is preserved for the future cloud-mode flip; restore the {\"storage\": {\"rules\": \"storage.rules\"}} block then.",
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
