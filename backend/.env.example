# Copy to .env and fill in. Do NOT commit .env.

# --- Firebase / Google Cloud ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to the downloaded service-account JSON.
# Used by Firebase Admin SDK + every google-cloud-* client.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Cloud Storage bucket used for audio + PDFs (e.g. "your-project.appspot.com").
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Vertex AI (Gemini) — used for audio → SOAP ---
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
# gemini-2.5-flash is ~10x cheaper than 2.5-pro; flip to pro when ready.
VERTEX_MODEL=gemini-2.5-flash

# --- Audio → SOAP provider ---
# vertex_gemini = real Vertex AI Gemini call (billed)
# fake          = canned response, zero cost, useful for UI iteration
AUDIO_TO_SOAP_PROVIDER=vertex_gemini

# Hard cap on audio length sent to the LLM (Gemini handles ~9.5 min reliably).
MAX_AUDIO_DURATION_MS=540000

# --- App ---
APP_ENV=development      # development | production
LOG_LEVEL=INFO
# Comma-separated list of allowed origins for the Expo dev client + your web preview.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006
