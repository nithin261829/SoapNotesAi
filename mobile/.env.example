# Copy to .env. Do NOT commit .env.
#
# Firebase web SDK config (safe to ship in the client bundle — Firebase keys
# are public identifiers; security relies on Auth + rules, not on hiding these).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend base URL. For Expo Go on a real device, point at your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Sign-In via expo-auth-session. The Web client ID is always required
# (Firebase audiences against it). For native builds, also create platform-
# specific OAuth clients in Google Cloud Console and set their IDs below.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
